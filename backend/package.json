{
  "name": "marauders-api",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "deploy": "node scripts/deploy.mjs",
    "deploy:staging": "node scripts/deploy.mjs --env staging",
    "deploy:production": "node scripts/deploy.mjs --env production",
    "typecheck": "tsc --noEmit",
    "test": "npm run typecheck && npm run test:scripts && npm run test:health && npm run test:feed && npm run test:dubbed-audio && npm run test:dev-auth && npm run test:comments && npm run test:likes && npm run test:follows && npm run test:auth-refresh && npm run test:upload-idempotency && npm run test:account-deletion",
    "db:migrate": "node scripts/migrate.mjs",
    "video:hls": "node scripts/hls-transcode-r2.mjs",
    "db:purge": "node scripts/purge-videos.mjs",
    "test:scripts": "node --test test/scripts/*.test.mjs",
    "test:health": "node scripts/test-health.mjs",
    "test:feed": "node scripts/test-feed.mjs",
    "test:dubbed-audio": "node scripts/test-dubbed-audio.mjs",
    "test:dev-auth": "node scripts/test-dev-auth.mjs",
    "test:comments": "node scripts/test-comments.mjs",
    "test:likes": "node scripts/test-likes.mjs",
    "test:follows": "node scripts/test-follows.mjs",
    "test:auth-refresh": "node scripts/test-auth-refresh.mjs",
    "test:upload-idempotency": "node scripts/test-upload-idempotency.mjs",
    "test:account-deletion": "node scripts/test-account-deletion.mjs"
  },
  "dependencies": {
    "@neondatabase/serverless": "^0.10.4",
    "jose": "^5.10.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261013.1",
    "typescript": "^5.7.3",
    "wrangler": "^4.150.0",
    "esbuild": "^0.28.2"
  },
  "overrides": {
    "undici": "^7.30.1"
  }
}
