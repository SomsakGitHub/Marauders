default_platform(:ios)

APP_IDENTIFIER = "com.somsak.Marauders"
TEAM_ID        = "9U8PYJFN94"
SCHEME         = "Marauders"
PROJECT_ROOT   = File.expand_path("..", __dir__)

# fastlane executes shell commands from the `fastlane/` directory, so anchor
# every lane to the project root (where Marauders.xcodeproj lives).
def in_project(&block)
  Dir.chdir(PROJECT_ROOT, &block)
end

platform :ios do
  desc "Run the unit test suite (MaraudersTests) and emit build/test/junit.xml"
  lane :test do
    in_project do
      destination = ENV["SIMULATOR_DESTINATION"] || "platform=iOS Simulator,name=iPhone 17"

      FileUtils.rm_rf("build/test")
      FileUtils.mkdir_p("build/test")

      xcodebuild = [
        "xcodebuild test",
        "-scheme #{SCHEME}",
        "-destination '#{destination}'",
        "-only-testing:MaraudersTests",
        "-enableCodeCoverage YES",
        "-resultBundlePath build/test/Marauders.xcresult"
      ].join(" ")

      begin
        # `set -o pipefail` makes the lane fail when xcodebuild fails, even
        # though the pipeline exit code would otherwise come from xcbeautify.
        sh("set -o pipefail; #{xcodebuild} 2>&1 | xcbeautify")
      ensure
        # Emit JUnit from the xcresult even when tests fail, so Jenkins can
        # publish results. xcresultparser understands Swift Testing.
        if File.exist?("build/test/Marauders.xcresult")
          sh("xcresultparser -o junit build/test/Marauders.xcresult > build/test/junit.xml")
          # Cobertura XML feeds the Jenkins "Coverage" plugin so it can render
          # a dedicated coverage tab (line/branch/method). `--project-root`
          # rewrites absolute file paths relative to the project for readable
          # class names and source links.
          sh("xcresultparser -o cobertura -p \"$(pwd)\" build/test/Marauders.xcresult > build/test/coverage.xml")
        end
      end
    end
  end

  desc "Build a Release .ipa for App Store distribution (no upload)"
  lane :build do
    in_project do
      xcargs = ["-allowProvisioningUpdates"]
      # Signing against App Store Connect needs API key credentials; they are
      # optional so the lane can still archive for smoke-testing locally.
      if ENV["ASC_KEY_PATH"] && ENV["ASC_KEY_ID"] && ENV["ASC_ISSUER_ID"]
        xcargs += [
          "-authenticationKeyPath", ENV.fetch("ASC_KEY_PATH"),
          "-authenticationKeyID", ENV.fetch("ASC_KEY_ID"),
          "-authenticationKeyIssuerID", ENV.fetch("ASC_ISSUER_ID")
        ]
      end
      build_number = ENV["BUILD_NUMBER"].to_s
      xcargs << "CURRENT_PROJECT_VERSION=#{build_number}" unless build_number.empty?

      # Resolve paths against the project root explicitly: fastlane runs
      # project-based actions from one level above `in_project` (it does its own
      # `Dir.chdir("..")`), so a relative `project` would point at the wrong folder.
      gym(
        project: File.join(PROJECT_ROOT, "#{SCHEME}.xcodeproj"),
        scheme: SCHEME,
        configuration: "Release",
        export_method: "app-store",
        output_directory: File.join(PROJECT_ROOT, "build"),
        output_name: "#{SCHEME}.ipa",
        xcargs: xcargs.join(" ")
      )
    end
  end

  desc "Build a Release archive and upload it to TestFlight"
  lane :beta do
    build

    in_project do
      api_key = app_store_connect_api_key(
        key_id: ENV.fetch("ASC_KEY_ID"),
        issuer_id: ENV.fetch("ASC_ISSUER_ID"),
        key_filepath: ENV.fetch("ASC_KEY_PATH"),
        in_house: false
      )

      pilot(
        api_key: api_key,
        app_identifier: APP_IDENTIFIER,
        skip_waiting_for_build_processing: true,
        distribute_external: false
      )
    end
  end
end
