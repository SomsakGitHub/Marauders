require "shellwords"

default_platform(:ios)

APP_IDENTIFIER = "com.somsak.Marauders"
TEAM_ID        = "9U8PYJFN94"
PROJECT_ROOT   = File.expand_path("..", __dir__)

# The project and the ipa are named Marauders. The app has two builds, one scheme each: Staging is what runs from Xcode
# (the in-app log and the other Debug aids) and Production is what TestFlight and the App Store ship. Both are built
# for the production Worker for now (ADR-010).
PROJECT_NAME          = "Marauders"
TEST_SCHEME           = "Marauders Staging"
RELEASE_SCHEME        = "Marauders Production"
RELEASE_CONFIGURATION = "Release-Production"

# fastlane executes shell commands from the `fastlane/` directory, so anchor
# every lane to the project root (where Marauders.xcodeproj lives).
def in_project(&block)
  Dir.chdir(PROJECT_ROOT, &block)
end

# The plist that starts Firebase (docs/adr/012-force-update.md) is not in the repository, which is public. Jenkins hands
# it over as a file credential (docs/ci-cd.md): copy it into the app's folder, where the target bundles it. Without the
# variable (a run on this Mac) nothing is touched, and a plist that is already in the folder stays. Jenkins writes the
# credential read-only and a plain copy of it would be read-only too, so the lane that places it twice (`beta`, then
# `build`) could not write over its own first copy: the copy is made beside the file and renamed over it, which also
# leaves the folder's plist alone when the source cannot be read, or when the variable names that very file.
def place_firebase_plist
  source = ENV["FIREBASE_PLIST_PATH"].to_s.strip
  return if source.empty?

  target = File.join(PROJECT_ROOT, "Marauders", "GoogleService-Info.plist")
  beside = "#{target}.new"
  begin
    FileUtils.cp(source, beside)
    FileUtils.chmod(0o644, beside)
    File.rename(beside, target)
  ensure
    FileUtils.rm_f(beside)
  end
end

platform :ios do
  desc "Run the unit test suite (MaraudersTests) and emit build/test/junit.xml"
  lane :test do
    in_project do
      destination = ENV["SIMULATOR_DESTINATION"] || "platform=iOS Simulator,name=iPhone 17"

      FileUtils.rm_rf("build/test")
      FileUtils.mkdir_p("build/test")

      xcodebuild = [
        "xcodebuild test",
        "-scheme '#{TEST_SCHEME}'",
        "-destination '#{destination}'",
        "-only-testing:MaraudersTests",
        "-enableCodeCoverage YES",
        "-resultBundlePath build/test/Marauders.xcresult"
      ].join(" ")

      begin
        # `set -o pipefail` makes the lane fail when xcodebuild fails, even
        # though the pipeline exit code would otherwise come from xcbeautify.
        sh("set -o pipefail; #{xcodebuild} 2>&1 | xcbeautify")
      ensure
        # Emit JUnit from the xcresult even when tests fail, so Jenkins can
        # publish results. xcresultparser understands Swift Testing.
        if File.exist?("build/test/Marauders.xcresult")
          sh("xcresultparser -o junit build/test/Marauders.xcresult > build/test/junit.xml")
          # Cobertura XML feeds the Jenkins "Coverage" plugin so it can render
          # a dedicated coverage tab (line/branch/method). `--project-root`
          # rewrites absolute file paths relative to the project for readable
          # class names and source links.
          sh("xcresultparser -o cobertura -p \"$(pwd)\" build/test/Marauders.xcresult > build/test/coverage.xml")
        end
      end
    end
  end

  desc "Build a Production .ipa for App Store distribution (no upload)"
  lane :build do
    place_firebase_plist

    in_project do
      xcargs = ["-allowProvisioningUpdates"]
      # Signing against App Store Connect needs API key credentials; they are
      # optional so the lane can still archive for smoke-testing locally.
      if ENV["ASC_KEY_PATH"] && ENV["ASC_KEY_ID"] && ENV["ASC_ISSUER_ID"]
        xcargs += [
          "-authenticationKeyPath", ENV.fetch("ASC_KEY_PATH"),
          "-authenticationKeyID", ENV.fetch("ASC_KEY_ID"),
          "-authenticationKeyIssuerID", ENV.fetch("ASC_ISSUER_ID")
        ]
      end
      build_number = ENV["BUILD_NUMBER"].to_s
      xcargs << "CURRENT_PROJECT_VERSION=#{build_number}" unless build_number.empty?
      # The build-time value Jenkins injects (the credential `marauders-client-key`, docs/ci-cd.md): the pass the app
      # needs in order to run. A build setting given on the command line overrides the project's default (the pass),
      # which is what a plain Run from Xcode uses. `strip` so a credential pasted with a line break cannot end the
      # command line; `escape` because gym runs xcargs through a shell (the pass has spaces). Without the variable (a
      # run on this machine) the app keeps the project's default.
      client_key = ENV["MARAUDERS_CLIENT_KEY"].to_s.strip
      xcargs << "MARAUDERS_CLIENT_KEY=#{Shellwords.escape(client_key)}" unless client_key.empty?

      # Resolve paths against the project root explicitly: fastlane runs
      # project-based actions from one level above `in_project` (it does its own
      # `Dir.chdir("..")`), so a relative `project` would point at the wrong folder.
      gym(
        project: File.join(PROJECT_ROOT, "#{PROJECT_NAME}.xcodeproj"),
        scheme: RELEASE_SCHEME,
        configuration: RELEASE_CONFIGURATION,
        export_method: "app-store",
        output_directory: File.join(PROJECT_ROOT, "build"),
        output_name: "#{PROJECT_NAME}.ipa",
        xcargs: xcargs.join(" ")
      )
    end
  end

  desc "Build a Production archive and upload it to TestFlight"
  lane :beta do
    # The plist must be this app's before anything is archived (docs/adr/012-force-update.md): a build without it
    # starts and runs, but its force-update gate never reads the minimum. Paths are absolute because fastlane runs
    # shell commands from the `fastlane/` folder; `build` places the same file again, which changes nothing.
    place_firebase_plist
    sh(
      [
        "sh", File.join(PROJECT_ROOT, "Scripts", "check-firebase-plist.sh"),
        "--plist", File.join(PROJECT_ROOT, "Marauders", "GoogleService-Info.plist"),
        "--bundle-id", APP_IDENTIFIER
      ].map { |part| Shellwords.escape(part) }.join(" ")
    )
    build

    in_project do
      api_key = app_store_connect_api_key(
        key_id: ENV.fetch("ASC_KEY_ID"),
        issuer_id: ENV.fetch("ASC_ISSUER_ID"),
        key_filepath: ENV.fetch("ASC_KEY_PATH"),
        in_house: false
      )

      pilot(
        api_key: api_key,
        app_identifier: APP_IDENTIFIER,
        skip_waiting_for_build_processing: true,
        distribute_external: false
      )
    end
  end
end
